# Canonical public URL of the deployed site. Used for canonical links,
# Open Graph URLs, sitemap.xml and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://decisionlens.example.com

# PostgreSQL connection string for production, e.g.
#   postgres://user:password@host:5432/decisionlens?sslmode=require
# Leave unset in development to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=
# DATABASE_POOL_MAX=10

# --- AI Decision Analysis (optional) -----------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_. Without a key, the
# "Analyze My Result" button shows a friendly "temporarily unavailable" message
# and the calculators keep working normally.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini            # any model that supports Structured Outputs
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible endpoints
# AI_ANALYSIS_ENABLED=true            # set to false to switch the feature off
