# Canonical public URL of the deployed site. Used for canonical links,
# Open Graph URLs, sitemap.xml and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://decisionlens.example.com

# PostgreSQL connection string for production, e.g.
#   postgres://user:password@host:5432/decisionlens?sslmode=require
# Leave unset in development to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=
# DATABASE_POOL_MAX=10
